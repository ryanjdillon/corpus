  "cards": [
    {
      "dot": "emerald",
      "title": "Ingest line",
      "items": [
        "sources (one config entry each; IMAP / Gmail API fetchers) → classify → embeddings → pgvector store; ingest.py orchestrates, resumable via the sync_state cursor"
      ]
    },
    {
      "dot": "cyan",
      "title": "Derived branches",
      "items": [
        "enrichment reads documents, calls the model (guided JSON), upserts a derived enrichments table in the same store",
        "secret scan = deterministic pii + leaks (Betterleaks), packaged alone as corpus-detect (packages/detect); enrich_batch has the model confirm flagged candidates"
      ]
    },
    {
      "dot": "violet",
      "title": "Query + entrypoints",
      "items": [
        "search (HNSW + SQL) behind serving, which builds one MCP server per tier; cli runs serve <tier>, ingest, scan, enrich, sync, audit-secrets"
      ]
    }
  ]
