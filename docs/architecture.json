  "cards": [
    {
      "dot": "emerald",
      "title": "Ingest line",
      "items": [
        "fetchers (IMAP / Gmail API) → classify → embeddings → pgvector store; ingest.py orchestrates, resumable via the sync_state cursor"
      ]
    },
    {
      "dot": "cyan",
      "title": "Derived branches",
      "items": [
        "enrichment reads documents, calls the model (guided JSON), upserts a derived enrichments table in the same store",
        "secret scan = deterministic pii + leaks (Betterleaks); enrich_batch has the model confirm flagged candidates"
      ]
    },
    {
      "dot": "violet",
      "title": "Query + entrypoints",
      "items": [
        "search (HNSW + SQL) behind the api / mcp_server adapters; cli runs api, mcp, ingest, scan, enrich, audit-secrets"
      ]
    }
  ]
